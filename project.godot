[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/limits/temporary_memory_buffer_size=1024
jolt_physics_3d/limits/max_bodies=65536
jolt_physics_3d/limits/max_body_pairs=524288
jolt_physics_3d/limits/max_contact_constraints=131072

[rendering]

occlusion_culling/bvh_build_quality=1
rendering_device/driver.windows="d3d12"
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=8192
